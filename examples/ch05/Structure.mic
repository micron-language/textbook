module Structure

// see TESTLATER.md #2: invar is partially implemented; calling an invar
// procedure (at run time or in a const declaration) does not work yet, so
// cube is only declared here; the const usage is shown in prose only.
// tag::invar[]
procedure cube(x: integer): integer invar
begin
    return x*x*x
end cube
// end::invar[]

// tag::inline[]
procedure square(x: integer): integer inline
begin
    return x*x
end square
// end::inline[]

// tag::forward[]
procedure ^ odd(n: integer): bool

procedure even(n: integer): bool
begin
    if n = 0 then return true end
    return odd(n-1)
end even

procedure odd(n: integer): bool
begin
    if n = 0 then return false end
    return even(n-1)
end odd
// end::forward[]

// tag::constparam[]
procedure count(const s: ^array of char; c: char): integer
var i, n: integer
begin
    i := 0; n := 0
    while s[i] # 0x do
        if s[i] = c then inc(n) end
        inc(i)
    end
    return n
end count
// end::constparam[]

// tag::caseloop[]
procedure classify(const s: ^array of char)
var i: integer
begin
    i := 0
    loop
        case s[i] of
        | 'a'..'z', 'A'..'Z': print("L")
        | '0'..'9': print("D")
        | 0x: exit
        else print("?")
        end
        inc(i)
    end
    println("")
end classify
// end::caseloop[]

// tag::sumarray[]
procedure sum(const a: ^array of int32; n: uint32): int32
var i: uint32; s: int32
begin
    s := 0; i := 0
    while i < n do s := s + a[i]; inc(i) end
    return s
end sum
// end::sumarray[]

var text: array 20 of char

begin
    println(square(7))          // 49
    println(even(10))           // true
    text := "abc 123"
    println(count(@text, 'b'))  // 1
    classify(@text)             // LLL?DDD
    // tag::sumcall2[]
    println(sum(@{1,7,3,9}, 4))    // 20
    // end::sumcall2[]
end Structure
