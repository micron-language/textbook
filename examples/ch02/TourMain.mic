// tag::module[]
module TourMain

import Sorter

var
    a: array 8 of integer
    i: integer

begin
    a[0] := 5; a[1] := 3; a[2] := 8; a[3] := 1
    a[4] := 9; a[5] := 2; a[6] := 7; a[7] := 4
    Sorter.sort(@a, len(a))
    for i := 0 to len(a)-1 do print(a[i]); print(" ") end
    println("")
end TourMain
// end::module[]
